{
  "name": "threadscout-intent-finder",
  "version": "1.0.0",
  "description": "Animasi progres pemindaian dan score count-up reveal untuk ThreadScout Chrome Extension",
  "stages": [
    { "step": 1, "label": "Memindai post di halaman Threads…", "progress": 30 },
